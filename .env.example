# Copy this file to .env. Keep real credentials out of source control.
# Local Docker database (docker compose up -d):
DATABASE_URL="postgresql://movie_memory:movie_memory_local@localhost:5432/movie_memory?schema=public"
# Optional direct connection for migrations if DATABASE_URL uses a connection pooler.
# DIRECT_DATABASE_URL="postgresql://..."

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth Web application; authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# TMDB API Read Access Token (v4 bearer token, not the v3 API key).
TMDB_READ_ACCESS_TOKEN=""

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
